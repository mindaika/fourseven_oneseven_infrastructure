# Copy to .env and fill in. .env is gitignored and should be mode 0600.

# ha_sync role: write access to the homeassistant schema only.
# Provision the role first:  ALTER ROLE ha_sync LOGIN PASSWORD '<value>';
HA_EXPORT_DATABASE_URL=postgresql://ha_sync:CHANGEME@localhost:5432/garbanzodb

# Home Assistant config directory. Read READ-ONLY; never written.
HA_CONFIG_DIR=/home/mindaika/Source/fourseven_oneseven_infrastructure/homeassistant/config

# Health alerts are pushed through Home Assistant, because a failure that
# stops the sync writing to Postgres also stops it recording that failure,
# and cron redirecting to a log file alerts nobody.
HA_BASE_URL=http://localhost:8123
HA_TOKEN_FILE=/home/mindaika/.ha_token
