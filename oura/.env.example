# Get a Personal Access Token at https://cloud.ouraring.com/personal-access-tokens
OURA_ACCESS_TOKEN=

# Connects as the dedicated oura_sync role (see schema.sql) — scoped to the
# oura schema only, no access to dancetrak/website/public.
OURA_DATABASE_URL=postgresql://oura_sync:CHANGEME@localhost:5432/garbanzodb

# Read-only role for the MCP server / Claude App (see reporting_schema.sql)
# — SELECT-only, scoped to the reporting schema of views only.
CLAUDE_READER_DATABASE_URL=postgresql://claude_reader:CHANGEME@localhost:5432/garbanzodb
CLAUDE_READER_DATABASE_URL_CONTAINER=postgresql://claude_reader:CHANGEME@postgres:5432/garbanzodb

# OAuth login for the MCP server (see oauth_provider.py) — required by
# Claude Desktop for any remote connector.
OURA_MCP_SERVER_URL=https://oura-mcp.garbanzo.monster
OURA_MCP_USERNAME=CHANGEME
OURA_MCP_PASSWORD=CHANGEME
